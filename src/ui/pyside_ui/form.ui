  <property name="styleSheet">
   <string notr="true">/* Global QSS Style Sheet with Futura Font, 0px Label Borders, and Accent Colors */

QMainWindow, QWidget {
    background-color: #222831;
    color: #EEEEEE;
    font-family: &quot;Futura&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 18pt;
}

/* Panels, Groups, and Containers */
QFrame, QGroupBox, QTabWidget::pane, QDockWidget {
    background-color: #222831;
    border: 1px solid #393E46;
    border-radius: 4px;
    font-family: &quot;Futura&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
}

QGroupBox {
    margin-top: 15px;
    padding-top: 15px;
    font-size: 18pt;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    color: #D65A31;
}

/* Input Fields and Interactive Widgets */
QPushButton, QLineEdit, QTextEdit, QPlainTextEdit, QComboBox, QSpinBox, QDoubleSpinBox {
    background-color: #393E46;
    color: #EEEEEE;
    border: 1px solid #393E46;
    border-radius: 6px;
    padding: 10px 14px;
    font-family: &quot;Futura&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 18pt;
}

QPushButton:hover, QComboBox:hover {
    background-color: #393E46;
    border: 1px solid #D65A31;
    color: #D65A31;
}

QPushButton:pressed, QPushButton:checked {
    background-color: #D65A31;
    border: 1px solid #D65A31;
    color: #222831;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 1px solid #D65A31;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 28px;
    border-left: 1px solid #393E46;
}

QComboBox::drop-down:hover {
    border-left: 1px solid #D65A31;
}

/* Checkboxes and Radio Buttons */
QCheckBox, QRadioButton {
    spacing: 10px;
    font-family: &quot;Futura&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 18pt;
    background-color: transparent;
    border: 0px solid transparent;
    border-width: 0px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 24px;
    height: 24px;
    background-color: #393E46;
    border: 1px solid #393E46;
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 12px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #D65A31;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #D65A31;
    border: 1px solid #D65A31;
}

/* Tables, Lists, and Trees (Selection Highlight) */
QTableView, QListView, QTreeView {
    background-color: #393E46;
    alternate-background-color: #222831;
    color: #EEEEEE;
    border: 1px solid #393E46;
    gridline-color: #393E46;
    selection-background-color: #D65A31;
    selection-color: #222831;
    font-family: &quot;Futura&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
}

QHeaderView::section {
    background-color: #393E46;
    color: #EEEEEE;
    border: 1px solid #222831;
    font-family: &quot;Futura&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
}

/* Horizontal Sliders */
QSlider::groove:horizontal {
    background-color: #393E46;
    height: 10px;
    border-radius: 5px;
}

QSlider::sub-page:horizontal {
    background-color: #D65A31;
    border-radius: 5px;
}

QSlider::handle:horizontal {
    background-color: #393E46;
    border: 1px solid #D65A31;
    width: 24px;
    height: 24px;
    margin: -7px 0;
    border-radius: 12px;
}

QSlider::handle:horizontal:hover {
    background-color: #D65A31;
}

/* Vertical Sliders */
QSlider::groove:vertical {
    background-color: #393E46;
    width: 10px;
    border-radius: 5px;
}

QSlider::add-page:vertical {
    background-color: #D65A31;
    border-radius: 5px;
}

QSlider::handle:vertical {
    background-color: #393E46;
    border: 1px solid #D65A31;
    width: 24px;
    height: 24px;
    margin: 0 -7px;
    border-radius: 12px;
}

QSlider::handle:vertical:hover {
    background-color: #D65A31;
}

/* Progress Bars */
QProgressBar {
    background-color: #393E46;
    border: 1px solid #393E46;
    border-radius: 6px;
    text-align: center;
    color: #EEEEEE;
    font-family: &quot;Futura&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 16pt;
}

QProgressBar::chunk {
    background-color: #D65A31;
    border-radius: 5px;
}

/* Tabs */
QTabBar::tab {
    background-color: #393E46;
    color: #EEEEEE;
    padding: 10px 20px;
    border: 1px solid #393E46;
    border-bottom: none;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    font-family: &quot;Futura&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 18pt;
}

QTabBar::tab:hover {
    color: #D65A31;
}

QTabBar::tab:selected {
    background-color: #222831;
    border-color: #393E46;
    border-bottom-color: #222831;
    color: #D65A31;
}

/* Scrollbars */
QScrollBar:vertical {
    background-color: #222831;
    width: 14px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background-color: #393E46;
    border-radius: 7px;
    min-height: 24px;
    border: 1px solid #393E46;
}

QScrollBar::handle:vertical:hover {
    background-color: #D65A31;
    border: 1px solid #D65A31;
}

QScrollBar:horizontal {
    background-color: #222831;
    height: 14px;
    margin: 0px;
}

QScrollBar::handle:horizontal {
    background-color: #393E46;
    border-radius: 7px;
    min-width: 24px;
    border: 1px solid #393E46;
}

QScrollBar::handle:horizontal:hover {
    background-color: #D65A31;
    border: 1px solid #D65A31;
}

/* Explicitly set 0px border and Futura font for all labels */
QLabel {
    background-color: transparent;
    border: 0px solid transparent;
    border-width: 0px;
    color: #EEEEEE;
    font-family: &quot;Futura&quot;, &quot;Segoe UI&quot;, Arial, sans-serif;
    font-size: 18pt;
}</string>
